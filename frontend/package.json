{
    "name": "dashboard",
    "version": "1.0.0",
    "description": "Dashboard",
    "main": "dist-electron/main.cjs",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build && electron-builder",
        "build:electron": "node build-electron.mjs",
        "build:backend": "cd ../backend && go build -ldflags=\"-s -w\" -o bin/dashboard.exe cmd/main.go",
        "build:backend:dev": "cd ../backend && go build -ldflags=\"-s -w\" -o cmd/dashboard-backend.exe cmd/main.go",
        "preview": "vite preview",
        "electron:dev": "npm run build:backend:dev && npm run build:electron && concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
        "electron:build": "npm run build:backend && npm run build:electron && vite build && electron-builder"
    },
    "keywords": [
        "dashboard",
        "electron"
    ],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.2",
        "@vitejs/plugin-react": "^5.1.0",
        "autoprefixer": "^10.4.21",
        "concurrently": "^9.2.1",
        "cross-env": "^10.1.0",
        "electron": "^39.1.0",
        "electron-builder": "^26.0.12",
        "esbuild": "^0.25.12",
        "postcss": "^8.5.6",
        "tailwindcss": "^4.1.16",
        "typescript": "^5.9.3",
        "vite": "^7.2.1"
    },
    "dependencies": {
        "@tailwindcss/postcss": "^4.1.16",
        "@tiptap/extension-color": "^3.13.0",
        "@tiptap/extension-table": "^3.13.0",
        "@tiptap/extension-table-cell": "^3.13.0",
        "@tiptap/extension-table-header": "^3.13.0",
        "@tiptap/extension-table-row": "^3.13.0",
        "@tiptap/extension-text-align": "^3.13.0",
        "@tiptap/extension-text-style": "^3.13.0",
        "@tiptap/extension-underline": "^3.13.0",
        "@tiptap/react": "^3.13.0",
        "@tiptap/starter-kit": "^3.13.0",
        "lucide-react": "^0.552.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-router-dom": "^7.9.5",
        "wait-on": "^9.0.1"
    },
    "build": {
        "appId": "com.dashboard.app",
        "productName": "Dashboard",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "dist-electron/**/*",
            "!node_modules/**/*"
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "artifactName": "${productName}-${version}-${arch}.${ext}",
            "signAndEditExecutable": false,
            "signExts": []
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Dashboard"
        },
        "extraResources": [
            {
                "from": "../backend/bin/",
                "to": "backend",
                "filter": [
                    "**/*"
                ]
            }
        ]
    }
}
